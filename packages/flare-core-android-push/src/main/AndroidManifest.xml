<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Android 13 起展示通知要运行时授权；声明随模块并入应用，申请时机由应用决定。 -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- 华为、荣耀桌面的角标接口（FlareLauncherBadge）；其它桌面的角标来自通知本身。 -->
    <uses-permission android:name="com.huawei.android.launcher.permission.CHANGE_BADGE" />
    <uses-permission android:name="com.hihonor.android.launcher.permission.CHANGE_BADGE" />

    <!-- 自启动管理页属于各厂商的系统应用；Android 11 起要声明才判断得出它们在不在。 -->
    <queries>
        <package android:name="com.huawei.systemmanager" />
        <package android:name="com.hihonor.systemmanager" />
        <package android:name="com.miui.securitycenter" />
        <package android:name="com.coloros.safecenter" />
        <package android:name="com.oppo.safe" />
        <package android:name="com.coloros.oppoguardelf" />
        <package android:name="com.vivo.permissionmanager" />
        <package android:name="com.iqoo.secure" />
        <!-- 角标接口是桌面的内容提供者，同样要声明才看得见。 -->
        <provider android:authorities="com.huawei.android.launcher.settings" />
        <provider android:authorities="com.hihonor.android.launcher.settings" />
    </queries>

    <application>
        <!-- FCM 由 Firebase 自己的接收器转进来，这个服务不用导出。 -->
        <service
            android:name="com.flare.im.push.FlareFirebaseMessagingService"
            android:exported="false">
            <intent-filter>
                <action android:name="com.google.firebase.MESSAGING_EVENT" />
            </intent-filter>
        </service>

        <!--
            厂商通知的点击落点：服务端给厂商的点击意图指向这个固定组件，载荷放在 flare_push 附加数据里。
            它只把载荷转给启动页就结束；不响应网页链接（没有 BROWSABLE）。
        -->
        <activity
            android:name="com.flare.im.push.FlarePushOpenActivity"
            android:excludeFromRecents="true"
            android:exported="true"
            android:noHistory="true"
            android:taskAffinity=""
            android:theme="@android:style/Theme.Translucent.NoTitleBar">
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <data
                    android:host="open"
                    android:scheme="flarepush" />
            </intent-filter>
        </activity>
    </application>
</manifest>
