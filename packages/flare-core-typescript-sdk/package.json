{
  "name": "@flare-im/sdk",
  "version": "1.0.6",
  "description": "Flare IM client SDK for TypeScript — runtime-agnostic core with per-runtime transports (web/WASM, Tauri, React Native, uni-app).",
  "keywords": [
    "flare",
    "im",
    "instant-messaging",
    "chat",
    "websocket",
    "sdk",
    "typescript",
    "realtime",
    "wasm",
    "tauri"
  ],
  "type": "module",
  "main": "src/index.ts",
  "types": "src/index.ts",
  "bin": {
    "flare-web-retain-builds": "./devtools/vite/flareWebRetainBuilds.js"
  },
  "exports": {
    ".": "./src/index.ts",
    "./api": "./src/api/index.ts",
    "./listener": "./src/listener/index.ts",
    "./model": "./src/model/index.ts",
    "./callback": "./src/callback/index.ts",
    "./contract": "./src/contract/index.ts",
    "./devtools/vite": {
      "types": "./src/devtools/vite/index.ts",
      "import": "./devtools/vite/flareCoreWebAppVite.js",
      "default": "./devtools/vite/flareCoreWebAppVite.js"
    },
    "./media": "./src/media/index.ts",
    "./adapter/*": "./src/adapter/*.ts",
    "./bridge/*": "./src/bridge/*.ts",
    "./lifecycle": "./src/lifecycle/index.ts",
    "./update": "./src/update/index.ts",
    "./update/service-worker": "./src/update/service-worker.ts",
    "./web": "./src/adapters/web/index.ts",
    "./web/storage": "./src/adapters/web/idbWasmStorageHost.ts",
    "./web/access-store": "./src/adapters/web/idbAccessStoreHost.ts",
    "./tauri": "./src/adapters/tauri/index.ts",
    "./react-native": "./src/adapters/react-native/index.ts",
    "./uni-app": "./src/adapters/uni-app/index.ts",
    "./transport": "./src/adapters/_shared/transportProfile.ts",
    "./plugin-ui": "./src/plugin-ui/index.ts"
  },
  "scripts": {
    "build": "tsc --noEmit",
    "check": "tsc --noEmit",
    "typecheck": "tsc --noEmit",
    "verify:architecture": "node scripts/verify-no-client-shadow-views.mjs",
    "test": "node scripts/verify-no-client-shadow-views.mjs && vitest run"
  },
  "dependencies": {
    "protobufjs": "^8.6.5"
  },
  "peerDependencies": {
    "@tauri-apps/api": "^2.0.0"
  },
  "peerDependenciesMeta": {
    "@tauri-apps/api": {
      "optional": true
    }
  },
  "devDependencies": {
    "@tauri-apps/api": "2.11.0",
    "@types/node": "^22.10.2",
    "fake-indexeddb": "^6.2.7",
    "typescript": "^5.0.0",
    "vitest": "^3.2.6"
  },
  "license": "Apache-2.0",
  "files": [
    "src",
    "devtools",
    "!src/**/*.test.ts",
    "!src/**/*.spec.ts",
    "README.md",
    "LICENSE"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/flare-im/flare-core-sdk.git",
    "directory": "packages/flare-core-typescript-sdk"
  },
  "publishConfig": {
    "access": "public"
  }
}
