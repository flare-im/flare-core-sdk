# Legacy nested checkouts. The five reference apps now live in flare-core-examples.
examples/flare-core-web-app/
examples/flare-core-flutter-app/
examples/flare-core-ios-app/
examples/flare-core-android-app/
examples/flare-core-tauri-app/

# ── 依赖 ─────────────────────────────────────────────
node_modules/
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/releases

# ── Rust ─────────────────────────────────────────────
target/
**/*.rs.bk
Cargo.lock.bak

# ── Node / Web 构建产物 ──────────────────────────────
dist/
out/
.next/
.nuxt/
.output/
.vite/
.turbo/
*.tsbuildinfo

# ── Flutter / Dart ───────────────────────────────────
.dart_tool/
.flutter-plugins
.flutter-plugins-dependencies
.packages
.pub-cache/
.pub/
**/doc/api/

# ── iOS / macOS / Swift ──────────────────────────────
Pods/
DerivedData/
.build/
*.xcworkspace/xcuserdata/
xcuserdata/
*.xcuserstate
*.moved-aside
*.hmap
*.ipa
*.dSYM.zip

# ── Android / Gradle ─────────────────────────────────
.gradle/
local.properties
.cxx/
*.apk
*.aab
*.keystore
!debug.keystore

# ── 通用构建目录 ─────────────────────────────────────
# ⚠️ 裸 build/ 会误伤源码：packages/*/…/command/message/build/ 是消息构建器
# 源码目录（三端各 26 个文件），必须显式放行，否则静默丢失 78 个源文件。
build/
Build/
!**/command/message/build/
!**/command/message/build/**

# ── 原生编译产物 ─────────────────────────────────────
*.so
*.dylib
*.dll
*.a
*.o
*.class

# ── 环境 / 密钥（绝不入库）────────────────────────────
.env
.env.*
!.env.example
*.pem
*.p12
*.mobileprovision

# ── 编辑器 / 系统 ────────────────────────────────────
.DS_Store
Thumbs.db
.idea/
.vscode/*
!.vscode/extensions.json
*.swp

# ── 日志 / 缓存 / 测试产物 ───────────────────────────
*.log
npm-debug.log*
yarn-error.log*
.cache/
coverage/
test-results/
playwright-report/
