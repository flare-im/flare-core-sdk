      "name": "uploadFile",
      "operation": "media.upload_file",
      "transport": "ffi-symbol",
      "cApi": "flare_media_upload_file",
      "request": "UploadFileRequest",
      "response": "MediaUploadResponse",
      "stability": "stable",
      "description": "Existing request shape remains unchanged. Optional options follows MediaUploadOptions: purpose general (default/private) or avatar (validated public image with stable unsigned url/cdnUrl), and optional positive chunkSize. Avatar purpose is supported only for image inputs. options:{purpose:\"avatar\"} is valid without chunkSize. Persist the returned stable avatar URL, never a temporary getMediaUrl URL."
    },
